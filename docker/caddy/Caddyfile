# Єдина точка входу з інтернету. Робить три речі: TLS, маршрутизацію за
# доменом і — головне — дозволяє міняти версію сервіса без розриву.
#
# Чому не публікуємо порти сервісів напряму: два контейнери одного сервіса
# не можуть слухати один і той самий порт хоста, а саме два контейнери на
# секунду-дві й живуть під час викочування. Проксі вирішує це тим, що
# ходить у контейнери всередині мережі, де порт у кожного свій.
{
	email {$ACME_EMAIL:hello@extrovert.cafe}
	# Логи в stdout, як у решти сервісів: їх ротує докер, а не ми.
	log {
		output stdout
		format json
	}
}

# Проксі на сервіс за іменем у мережі compose.
#
# `dynamic a` замість звичайного upstream — це і є механізм миттєвого
# перемикання. Статичний upstream Caddy резолвить один раз на старті й
# тримає ту саму адресу; динамічний перепитує вбудований DNS докера
# (127.0.0.11) кожні дві секунди, тому новий контейнер потрапляє в пул
# одразу, як зʼявився, а зниклий — зникає.
#
# fail_duration + lb_try_duration: коли старий контейнер отримав SIGTERM і
# перестав приймати нові зʼєднання, перший невдалий запит просто йде на
# сусідній контейнер, а не назовні помилкою. Активні перевірки тут не
# вмикаємо навмисно — з динамічними upstream-ами вони не працюють.
(app) {
	reverse_proxy {
		dynamic a {
			name {args[0]}
			port {args[1]}
			refresh 2s
			resolvers 127.0.0.11
		}
		lb_policy least_conn
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1

		header_up X-Real-IP {remote_host}
	}
}

{$API_DOMAIN:api.extrovert.cafe} {
	# Вебхук ПРРО веде в checkbox, а не в api: це окремий сервіс, але
	# заводити під нього ще один домен і ще один сертифікат немає сенсу.
	handle /webhook/checkbox* {
		import app checkbox 3003
	}
	handle {
		import app api 3001
	}
}

{$WS_DOMAIN:ws.extrovert.cafe} {
	import app ws 3002
}

# Збір помилок. Окремий домен, бо це веб-інтерфейс, а не наше API.
{$ERRORS_DOMAIN:errors.extrovert.cafe} {
	reverse_proxy glitchtip:8000
}
