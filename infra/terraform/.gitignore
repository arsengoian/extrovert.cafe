# Стан терраформа тримає адреси й id ресурсів, а в майбутньому й секрети —
# у git йому не місце. Бекенд для спільного стану підключимо, коли над
# інфраструктурою працюватиме більше однієї людини.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# .terraform.lock.hcl навмисно НЕ ігнорується: це лок провайдерів,
# такий самий, як bun.lock — він і має їхати в git.
