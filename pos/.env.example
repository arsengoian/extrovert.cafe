# Оточення вирішує, у який бакет піде заливка:
# production → extrovert-pos, решта → extrovert-pos-dev (lib/src/r2.js)
APP_ENV=local

# Локальний S3 (MinIO з docker-compose у корені репозиторію)
R2_DEV_ENDPOINT=http://127.0.0.1:9100
R2_DEV_ACCESS_KEY_ID=extrovert-local
R2_DEV_SECRET_ACCESS_KEY=extrovert-local-secret

# Прод-ключі R2. На машині розробника їх краще не тримати взагалі:
# заливка в прод робиться з сервера або разово з APP_ENV=production.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
