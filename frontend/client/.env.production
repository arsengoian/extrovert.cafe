# Прод-збірка ходить у api на піддомені; локально працює проксі Vite.
VITE_API=https://api.extrovert.cafe/api/v1

# Події кіоска й телефона. Окремий домен, бо його віддає Caddy на
# дроплеті, а не воркер (docs/deploy.md §2.3).
VITE_WS=wss://ws.extrovert.cafe/

# Помилки застосунку — у GlitchTip, проєкт client (src/errors.js). DSN не
# секрет: він лише каже, куди слати, читати з ним не можна.
VITE_GLITCHTIP_DSN=https://76d2b9100214478b94e5375490995286@errors.extrovert.cafe/6

# Microsoft Clarity — записи сесій і теплові карти (src/clarity.js), лише на
# extrovert.cafe. ID проєкту не секрет: він і так стоїть у сторінці.
VITE_CLARITY_ID=yrdjcyzkbd
