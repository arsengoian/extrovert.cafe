# Образ раннера для act. Без цього рядка act на першому запуску питає його
# інтерактивно — і зависає в будь-якому скрипті.
-P ubuntu-latest=catthehacker/ubuntu:act-latest
# Порожнє оточення замість кореневого .env: інакше локальні змінні
# перекривають env воркфлоу (пояснення — у .github/act.env).
--env-file=.github/act.env
