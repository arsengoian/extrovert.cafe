# Фрагменти /boot/config.txt, які ми змінювали. РЕКОНСТРУКЦІЯ — звірити.
disable_overscan=1        # без цього фреймбуфер був 1216×672 замість 1280×720
hdmi_force_hotplug=1
hdmi_group=1
hdmi_mode=16              # 1080p60; монітор віддав його як (native) у EDID
hdmi_drive=2
hdmi_pixel_encoding=2     # повний RGB 0-255; інакше чорний виїздить сірим
