# EXTROVERT.CAFE — автозапуск нативного кіоска (pos-native) без X.
#
# Раніше кіоск піднімала LXDE autostart (~/.config/lxsession/LXDE-pi/autostart:
# @/home/pi/kiosk.sh), бо кіоском був сам браузер у графічній сесії. pos-native
# малює прямо в dispmanx-шар і жодного X/LXDE не потребує — тому за замовчанням
# тепер `systemctl set-default multi-user.target` (без графічного логіну), а
# кіоск піднімає systemd напряму.
#
# kiosk-native.sh сам має цикл перезапуску бінарника (restart-on-crash з
# логуванням, як і старий kiosk.sh) — Restart=always тут ловить лише той
# рідкісний випадок, коли впаде сам скрипт, а не бінарник усередині нього.
#
# Встановлення (одноразово, з правами root):
#   sudo cp pos-native.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pos-native.service
#
# Відкат на Chromium — дивись pi/README.md, розділ «Відкат на Chromium-кіоск».

[Unit]
Description=extrovert.cafe kiosk — pos-native (dispmanx, без X)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video
ExecStart=/home/pi/kiosk-native.sh
Restart=always
RestartSec=3
# kiosk-native.sh сам пише в ~/kiosk-native.log (exec >> "$LOG" 2>&1);
# те, що лишається на stdout/stderr юніта — тільки повідомлення systemd.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
