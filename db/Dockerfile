# Міграції окремим одноразовим контейнером, не всередині сервісу
# (docs/db-schema.md §6): порядок старту не має вирішувати, хто накотить
# схему, і відкат сервісу не має означати відкат бази.
#
# Версія закріплена так само, як у Bun: рухомий тег дав би різні бінарники
# на різних машинах.
FROM ghcr.io/amacneil/dbmate:2.36.0

# Поруч немає ні package.json, ні коду сервісів - спокуси імпортнути щось
# із них не виникає.
# dbmate шукає ./db/migrations відносно робочої теки, тому саме така
# розкладка, а не /db/migrations.
WORKDIR /app
COPY migrations ./db/migrations
