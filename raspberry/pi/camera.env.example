# Камера точки для stack/recorder.sh (docs/video.md, «Запис»).
#
# Скопіювати в raspberry/pi/camera.env (він у .gitignore), заповнити й
# покласти на малину в /home/pi/extrovert/config/camera.env (chmod 600).
# Лежить на розділі data, тож переживає оновлення й не потрапляє в релізи:
# релізи лежать у публічному бакеті.

# MAC камери: адресу вона бере по DHCP, recorder шукає її за MAC.
# kyiv-01 — Tapo C100 v5 (06.10.2026).
CAM_MAC=c0:3a:55:fc:7b:57

# «Акаунт камери» з застосунку Tapo: налаштування камери → Advanced Settings →
# Camera Account. Будь-які символи, лапки не потрібні: файл читається
# буквально, а в адресу потоку recorder підставляє їх із %-кодуванням.
CAM_USER=
CAM_PASS=

# stream1 — 1080p, stream2 — 360p.
CAM_STREAM=stream1
