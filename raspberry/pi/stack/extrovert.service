# EXTROVERT.CAFE — увесь наш стек на точці одним юнітом.
#
# Єдиний юніт стеку поза /home/pi/extrovert. Він навмисно тупий: підняти
# супервізора й не лізти далі. Склад стеку, версії, порядок запуску,
# оновлення — усе всередині нашої теки, куди можна писати без root.
# Замінив однокомпонентний pos-native.service 21.09.2026.
#
# Встановлення (один раз):
#   sudo cp extrovert.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now extrovert.service

[Unit]
Description=extrovert.cafe — стек точки (кіоск, апдейтер)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
# video — доступ до /dev/vchiq (dispmanx/GPU) без root
SupplementaryGroups=video
# Гасить світлодіоди мережевого чипа (llctl). Скрипт живе на пристрої, не в
# релізі (це налаштування заліза, а не наш код). «-» — щоб його відсутність
# на іншій малині не зупиняла стек; «+» — запуск від root, хоча юніт від pi:
# llctl говорить із чипом через USB, і без root мовчки нічого не робить
# (до 21.09.2026 світлодіоди насправді гасив root-крон, а не цей рядок).
# «+» є з systemd 231, на Stretch — 232. Сам скрипт мусить мати #!/bin/sh:
# bash запускав його й без шебанга, systemd — ні (Exec format error).
ExecStartPre=-+/home/pi/scripts/start.sh
ExecStart=/home/pi/extrovert/bin/supervisor.sh
Restart=always
RestartSec=5

# mixed: SIGTERM отримує лише супервізор, і він сам ґречно гасить дітей
# (кіоску потрібен чистий вихід, щоб звільнити dispmanx-шар). SIGKILL по
# всій групі — лише якщо не вклався в TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=45

# journal, а не append:/шлях — `append:` зʼявився в systemd 240, а на
# Stretch стоїть 232. Логи компонентів супервізор і так пише сам у
# logs/<компонент>.log; сюди йде лише його власний потік.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
