# /etc/fstab на pi. ДАМП з картки, не реконструкція (21.09.2026, оновлено
# 25.09.2026 разом із переходом на overlay).
#
# /mnt/buf — USB-флешка під буфер запису з камери. Не за UUID, а за міткою:
# нову флешку досить відформатувати з тією самою міткою
#   sudo mkfs.ext4 -L buf -m 0 /dev/sda1
# і fstab не чіпати (21.09.2026 флешку міняли саме так).
# nofail обов'язковий: без нього відсутня флешка = emergency mode на кожному
# завантаженні (так і сталося, README.md → «Провал завантаження»).
# device-timeout=10s — щоб без флешки не чекати дефолтні 90 с.
proc            /proc           proc    defaults          0       0
/dev/mmcblk0p6  /boot           vfat    defaults          0       2
# commit=300 — журнал ext4 скидається раз на пʼять хвилин, а не раз на пʼять
# секунд (25.09.2026). Наші процеси пишуть 17 МБ/добу, а картка бачила 292:
# різниця — журнальні блоки на кожен дрібний рядок у лог і в чергу
# телеметрії. Після правки 54 МБ/добу. Ціна — при знеструмленні зникає до
# пʼяти хвилин свіжих даних; сама ФС лишається цілою, це журнал і гарантує.
#
# Рядок кореня під overlay НЕ діє: overlayRoot.sh коментує його у верхньому
# шарі, інакше systemd-remount-fs перемонтовував би overlay з опціями ext4.
# Лишається на місці для того, хто завантажиться з `nooverlay`.
/dev/mmcblk0p7  /               ext4    defaults,noatime,commit=300  0       1
LABEL=buf /mnt/buf ext4 defaults,noatime,nodiratime,errors=remount-ro,nofail,x-systemd.device-timeout=10s 0 2
# Розділ під усе, що пишеться: стек, релізи, стан, логи. Корінь під overlayfs
# лише читається, тож це єдине місце на картці, куди йде запис, — і воно
# навмисно велике (6,6 ГБ), бо зношується рівно та частина картки, у яку
# пишуть (docs/raspberry-pi.md §6-тер, 25.09.2026). За міткою, а не за
# номером розділу: на NOOBS-картці номер залежить від розмітки, мітка — ні.
LABEL=data /home/pi/extrovert ext4 defaults,noatime,commit=300,nofail,x-systemd.device-timeout=10s 0 2
