# ── Оточення ──
# local | staging | production. Впливає на імена бакетів R2 і на те, чи
# дозволено писати в прод (lib/src/r2.js).
APP_ENV=local

# ── Postgres ──
POSTGRES_DB=extrovert
POSTGRES_USER=extrovert
POSTGRES_PASSWORD=
# Локальний запуск сервісів із хоста (не з compose): порт 5442, бо 5432
# часто зайнятий іншим постгресом.
DATABASE_URL_LOCAL=postgres://extrovert:ПАРОЛЬ@127.0.0.1:5442/extrovert
REDIS_URL=redis://127.0.0.1:6389

# ── Підпис токенів ──
# Ed25519 PEM одним рядком (переноси як \n). Без нього api щоразу генерує
# новий ключ на старті — і рестарт розлогінює всіх.
#   bun scripts/keys.mjs jwt   → надрукує готовий рядок
JWT_PRIVATE_KEY=

# ── Вхід через Google / Apple ──
# Поки порожні, застосунок пускає лише девелоперським входом (тільки local).
# Google: OAuth 2.0 Client ID у своєму Google Cloud проєкті, тип «Web».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID + ключ підпису (.p8) з Apple Developer.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── GlitchTip ──
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://localhost:8000

# ── Checkbox ПРРО ──
CHECKBOX_API=https://api.checkbox.ua
CHECKBOX_LOGIN=
CHECKBOX_PASSWORD=
# Тестові дані паралельно зі справжніми, щоб звести до мінімуму ймовірність випадкового використання справжніх даних
CHECKBOX_TEST_LOGIN=
CHECKBOX_TEST_PASSWORD=
CHECKBOX_WEBHOOK_KEY=          # key, який повертає POST /api/v1/webhook

# ── Telegram overseer ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OVERSEER_INTERVAL_MS=300000

# ── Cloudflare R2 (статика і меню точок) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=extrovert-pos

# ── Застосунок гравця ──
APP_ORIGIN=https://extrovert.cafe   # домен клієнта: з нього збираються посилання-репости /r/<token>

# ── OpenAI (чат із кавенятком) ──
OPENAI_API_KEY=                 # без нього чат працює в офлайн-режимі: переказує базу знань
OPENAI_MODEL=gpt-5-mini         # найновіша mini-модель на 20.09.2026
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VECTOR_STORE=            # id сховища, куди kb:push заливає базу знань

# ── Digital Ocean (Для terraform) ──
DIGITALOCEAN_API_KEY=

# ── Нова Пошта ──
NP_API_KEY=                     # з бізнес-кабінету НП; без нього scheduler не синхронізує довідник

# ── Оточення й бакети ──
# production → extrovert-pos / -video / -evidence / -uploads
# решта      → ті самі імена з суфіксом -dev (lib/src/r2.js)
APP_ENV=local
# Локальний S3 (MinIO з docker-compose): прод-ключів на дев-машині бути не має
R2_DEV_ENDPOINT=http://127.0.0.1:9100
R2_DEV_ACCESS_KEY_ID=extrovert-local
R2_DEV_SECRET_ACCESS_KEY=extrovert-local-secret

# ── mono pay (оплата монет карткою) ──
MONO_TOKEN=                     # X-Token із кабінету mono pay; без нього оплата працює лише як тестова в local
MONO_API=https://api.monobank.ua
API_ORIGIN=https://api.extrovert.cafe   # звідси збирається webHookUrl для mono

# ── Короткий домен для посилань-репостів ──
# Воркер redirect/ (r.extrovert.cafe) 302-ить на /r/<токен> у застосунку.
# Розкоментувати ПІСЛЯ того, як воркер викочений і домен відповідає: поки
# його немає, порожнє значення лишає посилання на APP_ORIGIN — вони робочі.
# REPOST_ORIGIN=https://r.extrovert.cafe
