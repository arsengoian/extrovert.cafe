# ── Postgres ──
POSTGRES_DB=extrovert
POSTGRES_USER=extrovert
POSTGRES_PASSWORD=

# ── GlitchTip ──
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://localhost:8000

# ── Checkbox ПРРО ──
CHECKBOX_API=https://api.checkbox.ua
CHECKBOX_LOGIN=
CHECKBOX_PASSWORD=
# Тестові дані паралельно зі справжніми, щоб звести до мінімуму ймовірність випадкового використання справжніх даних
CHECKBOX_TEST_LOGIN=
CHECKBOX_TEST_PASSWORD=
CHECKBOX_WEBHOOK_KEY=          # key, який повертає POST /api/v1/webhook

# ── Telegram overseer ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OVERSEER_INTERVAL_MS=300000

# ── Cloudflare R2 (статика і меню точок) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=extrovert-pos

# ── Застосунок гравця ──
APP_ORIGIN=https://extrovert.cafe   # домен клієнта: з нього збираються посилання-репости /r/<token>

# ── OpenAI (чат із кавенятком) ──
OPENAI_API_KEY=                 # без нього чат працює в офлайн-режимі: переказує базу знань
OPENAI_MODEL=gpt-5-mini         # найновіша mini-модель на 20.09.2026
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VECTOR_STORE=            # id сховища, куди kb:push заливає базу знань

# ── Нова Пошта ──
NP_API_KEY=                     # з бізнес-кабінету НП; без нього scheduler не синхронізує довідник
