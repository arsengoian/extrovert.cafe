# ── Оточення ──
# local | staging | production. Впливає на імена бакетів R2 і на те, чи
# дозволено писати в прод (lib/src/r2.js):
#   production → extrovert-pos / -video / -evidence / -uploads
#   решта      → ті самі імена з суфіксом -dev
APP_ENV=local

# ── Postgres ──
POSTGRES_DB=extrovert
POSTGRES_USER=extrovert
POSTGRES_PASSWORD=
# Локальний запуск сервісів із хоста (не з compose): порт 5442, бо 5432
# часто зайнятий іншим постгресом.
DATABASE_URL_LOCAL=postgres://extrovert:ПАРОЛЬ@127.0.0.1:5442/extrovert
REDIS_URL=redis://127.0.0.1:6389

# ── Підпис токенів ──
# Ed25519 PEM одним рядком (переноси як \n). Без нього api щоразу генерує
# новий ключ на старті — і рестарт розлогінює всіх.
#   bun scripts/keys.mjs jwt   → надрукує готовий рядок
JWT_PRIVATE_KEY=

# ── Вхід через Google / Apple ──
# Поки порожні, застосунок пускає лише девелоперським входом (тільки local).
# Google: OAuth 2.0 Client ID у своєму Google Cloud проєкті, тип «Web».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID + ключ підпису (.p8) з Apple Developer.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── GlitchTip ──
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://localhost:8000

# ── Checkbox ПРРО ──
CHECKBOX_API=https://api.checkbox.ua
CHECKBOX_LOGIN=
CHECKBOX_PASSWORD=
# Тестові дані паралельно зі справжніми, щоб звести до мінімуму ймовірність випадкового використання справжніх даних
CHECKBOX_TEST_LOGIN=
CHECKBOX_TEST_PASSWORD=
# Ключ ліцензії каси (кабінет Checkbox → каса): потрібен лише для реєстрації
# вебхука — bun run --filter @extrovert/checkbox webhook:register --set.
# Ключ підпису, який Checkbox видає у відповідь, сюди не пишеться: він
# похідний і лежить у базі (webhook_keys).
CHECKBOX_LICENSE_KEY=
CHECKBOX_TEST_LICENSE_KEY=

# ── Telegram overseer ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OVERSEER_INTERVAL_MS=300000

# ── Бот підтримки (Telegram) ──
# Окремий бот, не overseer: у нього пишуть гравці, а адмін відповідає з
# адмінки (docs/services.md, «Підтримка через Telegram»). Токен — від @BotFather.
SUPPORT_BOT_TOKEN=
# Без @: з нього кнопка «Підтримка» збирає посилання t.me/<бот>.
SUPPORT_BOT_USERNAME=
# Секрет заголовка вебхука: api відкидає все, що прийшло без нього.
#   bun scripts/keys.mjs secret → надрукує готовий рядок
SUPPORT_BOT_SECRET=

# ── Cloudflare R2 (статика і меню точок) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=extrovert-pos

# ── Застосунок гравця ──
APP_ORIGIN=https://extrovert.cafe   # домен клієнта: з нього збираються посилання-репости /r/<token>

# ── OpenAI (чат із кавенятком) ──
OPENAI_API_KEY=                 # без нього чат працює в офлайн-режимі: переказує базу знань
OPENAI_MODEL=gpt-5-mini         # найновіша mini-модель на 20.09.2026
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VECTOR_STORE=            # id сховища, куди kb:push заливає базу знань; створити — bun run kb:store

# ── Digital Ocean (Для terraform) ──
DIGITALOCEAN_API_KEY=

# ── GitHub (реєстр образів ghcr.io) ──
# Токен GitHub із write:packages. Образи приватні, і деплой логінить ним
# сервер у ghcr, щоб той міг їх тягнути (крок «Дати серверу доступ до
# реєстру»). У GitHub Actions він лежить секретом репозиторію й ще й пушить
# образи (без нього пушить GITHUB_TOKEN, а сервер лишається з тим логіном,
# що вже має). Тут він — лише для act: make act-secrets переносить його в
# .secrets для act-deploy. Сам act образів не пушить; на сервері в .env
# цей токен не потрібен.
GHCR_TOKEN=

# ── Нова Пошта ──
NP_API_KEY=                     # з бізнес-кабінету НП; без нього scheduler не синхронізує довідник

# ── Локальний S3 (MinIO з docker-compose) ──
# Бакети з суфіксом -dev (див. APP_ENV угорі); прод-ключів на дев-машині бути не має
R2_DEV_ENDPOINT=http://127.0.0.1:9100
R2_DEV_ACCESS_KEY_ID=extrovert-local
R2_DEV_SECRET_ACCESS_KEY=extrovert-local-secret

# ── mono pay (оплата монет карткою) ──
MONO_TOKEN=                     # X-Token із кабінету mono pay; без нього оплата працює лише як тестова в local
MONO_API=https://api.monobank.ua
API_ORIGIN=https://api.extrovert.cafe   # звідси збираються адреси вебхуків: mono, бот підтримки, Checkbox

# ── Короткий домен для посилань-репостів ──
# Воркер redirect/ (r.extrovert.cafe) 302-ить на /r/<токен> у застосунку.
# Розкоментувати ПІСЛЯ того, як воркер викочений і домен відповідає: поки
# його немає, порожнє значення лишає посилання на APP_ORIGIN — вони робочі.
# REPOST_ORIGIN=https://r.extrovert.cafe

# ── Прод: тільки для docker-compose.prod.yml на сервері ──
# Реєстр і тег образів. TAG переписує rollout.sh під час викочування —
# руками його чіпати не треба (docs/deploy.md §2.3).
REGISTRY=ghcr.io/arsengoian
TAG=latest
# Домени, які обслуговує Caddy. Сертифікати він бере сам.
ACME_EMAIL=hello@extrovert.cafe
API_DOMAIN=api.extrovert.cafe
WS_DOMAIN=ws.extrovert.cafe
ERRORS_DOMAIN=errors.extrovert.cafe
