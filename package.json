{
  "name": "extrovert-cafe",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "backend/lib",
    "backend/api",
    "backend/ws",
    "backend/checkbox",
    "backend/overseer",
    "backend/scheduler",
    "frontend/client",
    "frontend/admin",
    "frontend/redirect",
    "frontend/qr"
  ],
  "scripts": {
    "up": "docker compose --profile local up -d postgres redis minio minio-buckets",
    "down": "docker compose --profile local down",
    "logs": "docker compose logs -f --tail=100",
    "docs:map": "bun scripts/build-data-map.mjs",
    "docs:map:check": "bun scripts/build-data-map.mjs --check",
    "lint": "eslint .",
    "seed:pull": "bun scripts/seed.mjs pull",
    "seed:apply": "bun scripts/seed.mjs apply",
    "planting:data": "bun scripts/build-planting-data.mjs",
    "dev:seed": "bun scripts/dev-seed.mjs",
    "dev:plant": "bun scripts/dev-plant.mjs",
    "kb:check": "bun scripts/kb.mjs check",
    "kb:embed": "bun scripts/kb.mjs embed",
    "kb:store": "bun scripts/kb.mjs store",
    "kb:push": "bun scripts/kb.mjs push",
    "kb:ask": "bun scripts/kb.mjs ask",
    "deploy:front": "bun scripts/deploy-front.mjs",
    "deploy:client": "bun scripts/deploy-front.mjs client",
    "deploy:client:dry": "bun scripts/deploy-front.mjs client --dry",
    "smoke": "bun scripts/smoke.mjs",
    "keys:jwt": "bun scripts/keys.mjs jwt",
    "keys:ssh": "bun scripts/keys.mjs ssh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "marked": "^18.0.13",
    "pngjs": "^7.0.0"
  }
}
